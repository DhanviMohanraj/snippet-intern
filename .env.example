# ==============================================================================
# Electronics Recommendation Agent - Environment Configuration Template
# ==============================================================================

# Local MongoDB Configuration
# Connection URI for the local MongoDB database instance (default: localhost:27017)
MONGO_URI=mongodb://localhost:27017

# Name of the MongoDB database used by the agent
MONGO_DB=electronics_agent

# Groq LLM Cloud API Configuration
# Base URL for Groq API (must be exactly https://api.groq.com/openai/v1)
LLM_BASE_URL=https://api.groq.com/openai/v1

# Private Groq API key (Never commit real API keys to version control)
LLM_API_KEY=replace_me

# Default LLM model identifier for Groq inference
LLM_MODEL=openai/gpt-oss-20b

# Optional fallback LLM base URL and model if primary endpoint fails
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_MODEL=

# LLM request timeout in seconds (must be positive)
LLM_TIMEOUT_S=30

# Maximum retry attempts for failed LLM requests (must be >= 0)
LLM_MAX_RETRIES=2

# CORS Allowed Origins
# Formatted as a JSON array of allowed origins for web clients
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
